{
  "$comment": "Not part of the `tsc -b` build graph (Wrangler type-checks the Worker at deploy time). Run `npx tsc -p tsconfig.worker.json --noEmit` to check it manually.",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowArbitraryExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "erasableSyntaxOnly": true
  },
  "include": ["worker.ts"]
}
