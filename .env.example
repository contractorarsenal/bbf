# These are Cloudflare Worker env vars, not Vite client vars — never prefix
# a secret with VITE_ (that would bundle it into the client). The frontend
# never reads these directly; it only talks to POST /api/assistant.

# "demo" = deterministic dev-only fallback. "anthropic" = the real assistant.
AI_PROVIDER=demo

# Server-side only. For local `wrangler dev`, copy this file to .dev.vars and
# fill in the real key (both are gitignored). In production, set it with:
#   npx wrangler secret put ANTHROPIC_API_KEY
# Never commit a real key, never expose it to the client, never log it.
ANTHROPIC_API_KEY=
